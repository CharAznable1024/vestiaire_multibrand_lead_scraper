{
  "$schema": "https://apify.com/schemas/v1/dataset.ide.json",
  "actorSpecification": 1,
  "fields": {
    "type": "object",
    "properties": {
      "record_type": { "type": "string" },
      "schema_version": { "type": "string" },
      "seller_id": { "type": "string" },
      "seller_name": { "type": ["string", "null"] },
      "seller_username": { "type": ["string", "null"] },
      "profile_url": { "type": "string" },
      "seller_segment": { "type": "string" },
      "seller_country": { "type": ["string", "null"] },
      "seller_country_code": { "type": ["string", "null"] },
      "items_sold": { "type": ["integer", "null"] },
      "items_listed": { "type": ["integer", "null"] },
      "items_bought": { "type": ["integer", "null"] },
      "items_wished": { "type": ["integer", "null"] },
      "pass_rate": { "type": ["number", "null"] },
      "seller_badge": { "type": ["string", "null"] },
      "badges": { "type": "array", "items": { "type": "string" } },
      "is_official_store": { "type": "boolean" },
      "vacation_active": { "type": ["boolean", "null"] },
      "categories": { "type": "array", "items": { "type": "string" } },
      "brands": { "type": "array", "items": { "type": "string" } },
      "source_queries": { "type": "array", "items": { "type": "string" } },
      "sample_listing_count": { "type": "integer" },
      "total_likes": { "type": "integer" },
      "average_price": { "type": ["number", "null"] },
      "price_currency": { "type": ["string", "null"] },
      "sample_product_urls": { "type": "array", "items": { "type": "string" } },
      "seller_detail_source_url": { "type": ["string", "null"] },
      "seller_detail_status": { "type": "string" },
      "lead_score": { "type": "integer" },
      "qualification": { "type": "string" },
      "qualification_reasons": { "type": "array", "items": { "type": "string" } },
      "dedupe_status": { "type": "string" },
      "first_seen_at": { "type": "string" },
      "last_seen_at": { "type": "string" },
      "times_seen": { "type": "integer" },
      "official_website": { "type": ["string", "null"] },
      "contact_candidate_url": { "type": ["string", "null"] },
      "public_business_emails": { "type": "array", "items": { "type": "string" } },
      "public_business_phones": { "type": "array", "items": { "type": "string" } },
      "social_urls": { "type": "array", "items": { "type": "string" } },
      "contact_source_urls": { "type": "array", "items": { "type": "string" } },
      "contact_confidence": { "type": "integer" },
      "contact_status": { "type": "string" },
      "contact_error": { "type": ["string", "null"] },
      "scraped_at": { "type": "string" }
    }
  },
  "views": {
    "merchant_leads": {
      "title": "Merchant leads",
      "transformation": {
        "fields": [
          "seller_name",
          "seller_username",
          "profile_url",
          "items_sold",
          "items_listed",
          "seller_segment",
          "seller_country",
          "seller_country_code",
          "categories",
          "brands",
          "seller_badge",
          "lead_score",
          "qualification",
          "official_website",
          "public_business_emails",
          "public_business_phones",
          "contact_confidence",
          "contact_status",
          "dedupe_status",
          "sample_listing_count",
          "sample_product_urls",
          "first_seen_at",
          "last_seen_at",
          "times_seen"
        ]
      },
      "display": {
        "component": "table",
        "properties": {
          "seller_name": { "label": "Seller", "format": "text" },
          "seller_username": { "label": "Username", "format": "text" },
          "profile_url": { "label": "Vestiaire profile", "format": "link" },
          "items_sold": { "label": "Items sold", "format": "number" },
          "items_listed": { "label": "Items listed", "format": "number" },
          "seller_segment": { "label": "Segment", "format": "text" },
          "seller_country": { "label": "Country", "format": "text" },
          "seller_country_code": { "label": "Country code", "format": "text" },
          "categories": { "label": "Categories", "format": "array" },
          "brands": { "label": "Brands", "format": "array" },
          "seller_badge": { "label": "Badge", "format": "text" },
          "lead_score": { "label": "Lead score", "format": "number" },
          "qualification": { "label": "Qualification", "format": "text" },
          "official_website": { "label": "Official website", "format": "link" },
          "public_business_emails": { "label": "Business emails", "format": "array" },
          "public_business_phones": { "label": "Business phones", "format": "array" },
          "contact_confidence": { "label": "Contact confidence", "format": "number" },
          "contact_status": { "label": "Contact status", "format": "text" },
          "dedupe_status": { "label": "Change", "format": "text" },
          "sample_listing_count": { "label": "Sample listings", "format": "number" },
          "sample_product_urls": { "label": "Evidence", "format": "array" },
          "first_seen_at": { "label": "First seen", "format": "date" },
          "last_seen_at": { "label": "Last seen", "format": "date" },
          "times_seen": { "label": "Times seen", "format": "number" }
        }
      }
    }
  }
}
